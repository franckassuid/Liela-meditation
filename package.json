{
  "name": "liela",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:sessions": "tsx scripts/sync-sessions.ts",
    "boost:cues": "tsx scripts/boost-all-cues.ts",
    "predev": "npm run sync:sessions && npm run build:push",
    "prebuild": "tsx scripts/sync-sessions.ts && node scripts/build-push-worker.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "firebase:emulators": "firebase emulators:start --only auth,firestore --project demo-liela",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage --project liela-9426c",
    "firebase:catalog": "node --import tsx scripts/import-firebase-catalog.ts",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-liela \"node --import tsx --test --test-concurrency=1 tests/firebase/*.test.ts\"",
    "build:push": "node scripts/build-push-worker.mjs",
    "build:reminders": "node scripts/build-reminder-worker.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.2",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
